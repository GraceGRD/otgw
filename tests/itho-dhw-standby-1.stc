test "Itho DHW standby handshake and override release"
constraint p16f1847

# Message ID 130 controls DHW Boost, Off and Stand-by modes.
# Eco and Comfort modes are controlled separately via HW=state.
# QH=S (DHW standby) mimics the Spider Stand-by mode: the boiler is
# partially disabled, while weekly legionella prevention remains enabled.
# Data layout: xxxx tttt bbbb xxxx; tttt = thermostat control bits,
# bbbb = boiler status bits. Stand-by uses 1000: 0x0800 control,
# 0x0080 status. The outer nibbles are don't-care bits.

load boiler-itho-wpu5g.stc
load thermostat-itho-wpu5g.stc

# With no QH override, Message ID 130 passes through unchanged.
go 4000000
check T.082.... T00820000
check B.082.... B4082000D

mark
Serial.tx = "QH=S\r"
go 8000000
check {QH: \S+} {QH: S}
check R.082.... R80820800
check B.082.... B4082000D
check A.082.... AC082080D

# Echoing the Stand-by control bit with a clear status bit is not an
# acknowledgement; the gateway keeps requesting the mode.

mark
Boiler.response = 0xC082080D
go 12000000
check R.082.... R80820800
check B.082.... BC082080D
check A.082.... AC082080D

# The boiler acknowledges Stand-by by setting the matching status bit
# alongside the thermostat control bit.

mark
Boiler.response = 0x4082088D
go 16000000
check R.082.... R80820800
check B.082.... B4082088D
check A.082.... A4082088D

# Unlike the one-shot Boost cycle, Stand-by remains overridden even if
# the boiler later clears its status bit.

mark
Boiler.response = 0xC082080D
go 20000000
check R.082.... R80820800
check B.082.... BC082080D
check A.082.... AC082080D

# Any single-character QH argument other than C, B or S disables the
# override and restores normal thermostat traffic.

mark
Serial.tx = "QH=X\r"
go 24000000
check {QH: \S+} {QH: 0}

mark
go 28000000
check R.082.... {}
check T.082.... T00820000
check B.082.... BC082080D
